
ARG SUITE=trixie

FROM debian:${SUITE}


RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    build-essential \
    debhelper \
    dh-python \
    dh-virtualenv \
    python3 \
    python3-dev \
    python3-setuptools \
    python3-venv \
    pkg-config \
    devscripts \
    equivs \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /work

CMD ["dpkg-buildpackage", "-us", "-uc", "-b"]
